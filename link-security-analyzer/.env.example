# Copy to .env and fill in real values. Never commit .env to Git.
# Placeholder values below are for local dev only.

# Postgres (async for FastAPI, sync for Celery worker / Alembic)
DATABASE_URL=postgresql+asyncpg://trueintent:trueintent@postgres:5432/trueintent
SYNC_DATABASE_URL=postgresql+psycopg2://trueintent:trueintent@postgres:5432/trueintent
POSTGRES_USER=trueintent
POSTGRES_PASSWORD=trueintent
POSTGRES_DB=trueintent

# Redis (Celery broker + cache)
REDIS_URL=redis://redis:6379/0

# Threat-feed keys (empty = feeds disabled, module still runs)
GSB_API_KEY=
VT_API_KEY=

# Timeouts and budgets (seconds)
WHOIS_TIMEOUT_SECONDS=3.0
DNS_TIMEOUT_SECONDS=2.0
NETGUARD_DENYLIST=localhost,redis,postgres,backend,worker
THREAT_FEED_TIMEOUT_SECONDS=3.0
FAST_PATH_BUDGET_SECONDS=5.0
SANDBOX_ENABLED=true
SANDBOX_PAGE_TIMEOUT_SECONDS=15

# Heuristic knobs
ENTROPY_THRESHOLD=4.5
ENTROPY_MIN_LENGTH=24
PHASH_DISTANCE_THRESHOLD=10

# Rate limits (requests per minute)
RATE_LIMIT_SCAN_PER_MIN=20
RATE_LIMIT_GET_PER_MIN=120

# Web origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000
