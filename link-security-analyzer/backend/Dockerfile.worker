# TrueIntent Celery worker (background browser sandbox).
# Uses the official Playwright Python image whose version matches the pinned
# `playwright` package in requirements.txt (playwright==1.48.0), so the
# bundled Chromium already works and no `playwright install` is needed.
FROM mcr.microsoft.com/playwright/python:v1.48.0-jammy

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /code

COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY data ./data
COPY app ./app

# The Playwright image ships a non-root `pwuser`; run as that user so
# hostile pages are never opened as root.
USER pwuser

# Start the configured worker that consumes sandbox scan tasks from Redis.
CMD ["celery", "-A", "app.workers.celery_app:celery_app", "worker", "--loglevel=info"]
