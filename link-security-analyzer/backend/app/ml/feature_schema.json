{
  "version": "1.0",
  "description": "ML feature schema for phishing detection",
  "features": {
    "url_len": {
      "dtype": "int64",
      "description": "Total URL length in characters"
    },
    "host_len": {
      "dtype": "float64",
      "description": "Hostname length"
    },
    "entropy": {
      "dtype": "float64",
      "description": "Shannon entropy of registrable domain label"
    },
    "digit_count": {
      "dtype": "float64",
      "description": "Number of digits in hostname"
    },
    "hyphen_count": {
      "dtype": "float64",
      "description": "Number of hyphens in hostname"
    },
    "dot_count": {
      "dtype": "float64",
      "description": "Number of dots in hostname"
    },
    "subdomain_count": {
      "dtype": "float64",
      "description": "Number of subdomain labels"
    },
    "has_ip_host": {
      "dtype": "float64",
      "description": "1 if host is IP address, 0 otherwise"
    },
    "has_at": {
      "dtype": "float64",
      "description": "1 if URL contains @ symbol, 0 otherwise"
    },
    "has_punycode": {
      "dtype": "float64",
      "description": "1 if domain uses punycode (xn--), 0 otherwise"
    },
    "is_https": {
      "dtype": "float64",
      "description": "1 if HTTPS, 0 if HTTP or other"
    },
    "port_nonstandard": {
      "dtype": "float64",
      "description": "1 if port is not 80/443, 0 otherwise"
    },
    "keyword_counts": {
      "dtype": "float64",
      "description": "Count of sensitive keywords (login, verify, etc.)"
    },
    "is_shortener": {
      "dtype": "float64",
      "description": "1 if domain is known URL shortener, 0 otherwise"
    },
    "tld_risk": {
      "dtype": "float64",
      "description": "TLD risk category: 0=common, 1=neutral, 2=risky"
    },
    "has_typosquat_signal": {
      "dtype": "float64",
      "description": "1 if typosquat brand match detected, 0 otherwise"
    },
    "has_brand_in_subdomain": {
      "dtype": "float64",
      "description": "1 if brand keyword in subdomain, 0 otherwise"
    },
    "path_len": {
      "dtype": "float64",
      "description": "Path length (for optimistic model only)"
    },
    "has_path": {
      "dtype": "float64",
      "description": "1 if path present, 0 otherwise (for optimistic model)"
    },
    "domain_age_days": {
      "dtype": "float64",
      "description": "Domain age in days (imputed if missing)"
    },
    "domain_age_missing": {
      "dtype": "float64",
      "description": "1 if domain age unavailable, 0 otherwise"
    },
    "domain_age_lt_30": {
      "dtype": "float64",
      "description": "1 if domain < 30 days old, 0 otherwise"
    },
    "domain_age_lt_90": {
      "dtype": "float64",
      "description": "1 if domain < 90 days old, 0 otherwise"
    },
    "domain_age_gt_365": {
      "dtype": "float64",
      "description": "1 if domain >= 1 year old, 0 otherwise"
    },
    "dns_resolves": {
      "dtype": "float64",
      "description": "1 if DNS resolution succeeded, 0 otherwise"
    },
    "mx_present": {
      "dtype": "float64",
      "description": "1 if MX record exists, 0 otherwise"
    },
    "tls_age_days": {
      "dtype": "float64",
      "description": "TLS certificate age in days (imputed if missing)"
    },
    "tls_age_missing": {
      "dtype": "float64",
      "description": "1 if TLS age unavailable, 0 otherwise"
    },
    "tls_age_lt_7": {
      "dtype": "float64",
      "description": "1 if TLS cert < 7 days old, 0 otherwise"
    },
    "offline_mode": {
      "dtype": "float64",
      "description": "1 if extracted in offline mode, 0 otherwise"
    },
    "is_url": {
      "dtype": "float",
      "description": ""
    }
  }
}